<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/af_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/landing_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/af_purple"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_signup"
            android:backgroundTint="@color/af_purple"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClubOS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_clubos"
            android:backgroundTint="@color/af_purple"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_abc"
            android:backgroundTint="@color/af_purple"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClubOsSettings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Club OS Widget Credentials"
            android:strokeColor="@color/af_purple"
            android:textColor="@color/af_purple"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshWidget"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh Who's in Club Widget"
            android:strokeColor="@color/af_purple"
            android:textColor="@color/af_purple"
            android:layout_marginBottom="24dp" />

        <!-- Who's in the Club section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Who's in the Club"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/af_purple"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshWhosIn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open in Club OS"
            android:strokeColor="@color/af_purple"
            android:textColor="@color/af_purple"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/whosInStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the button to open Club OS and see who's currently in the club"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:textColor="@color/af_purple_darker" />

        <LinearLayout
            android:id="@+id/membersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="4dp"
            android:elevation="2dp" />

    </LinearLayout>
</ScrollView>
